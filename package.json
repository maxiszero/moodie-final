{
  "name": "moodie",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000 --app-dir backend-py",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test:python && npm run test:run --workspace frontend",
    "test:python": "python -m pytest backend-py",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspace frontend",
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend-py",
    "telegram:setup": "node scripts/setupTelegramBot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.2.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.15",
    "@rolldown/binding-linux-arm64-gnu": "1.0.0-rc.15",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0"
  }
}
